# ──────────────────────────────────────────────────────────────────
# .env.example  —  copy to .env and fill in values
# Member 2: Fake News Detection ML API
# ──────────────────────────────────────────────────────────────────

# Directory containing trained_model.pkl and vectorizer.pkl
# (provided by Member 1 — do NOT commit actual .pkl files to git)
MODELS_DIR=./models

# Comma-separated list of origins allowed to call this API (CORS)
# Member 3's Java backend URL goes here
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:4200

# Uvicorn server settings
HOST=0.0.0.0
PORT=8000
RELOAD=true
